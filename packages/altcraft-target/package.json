{
  "name": "@altcraft/target",
  "version": "1.0.0",
  "description": "Altcraft SDK target module for React Native",
  "author": "Altcraft (https://altcraft.com)",
  "homepage": "https://github.com/altcraft/react-native-sdk",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/altcraft/react-native-sdk.git",
    "directory": "packages/altcraft-target"
  },
  "source": "./src/index.ts",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "react-native": "./src/index.ts",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      },
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "LICENSE",
    "README.md",
    "android",
    "ios",
    "*.podspec",
    "!android/build",
    "!android/.gradle",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@altcraft/core": "^1.0.0",
    "@altcraft/push": "^1.0.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.75"
  },
  "codegenConfig": {
    "name": "RNSdkTarget",
    "type": "modules",
    "jsSrcsDir": "src/native",
    "android": {
      "javaPackageName": "com.altcraft.sdk.target"
    },
    "ios": {
      "modules": {
        "Target": {
          "className": "TargetModule"
        }
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  }
}
